{
	auto_https off
}

:3000 {
	encode gzip

	handle /api/* {
		reverse_proxy {$OIKOS_AUTHORITY:authority:3000}
	}

	handle /healthz {
		reverse_proxy {$OIKOS_AUTHORITY:authority:3000}
	}

	handle /mcp {
		reverse_proxy {$OIKOS_AUTHORITY:authority:3000}
	}

	handle {
		root * /srv
		file_server

		@hashed path_regexp -[A-Za-z0-9_-]{8}\.(js|css)$
		header @hashed Cache-Control "public, max-age=31536000, immutable"
	}
}
