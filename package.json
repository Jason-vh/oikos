{
  "name": "zeus",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "bun test src",
    "smoke": "bun scripts/smoke.mjs",
    "pilot": "bun scripts/pilot.ts",
    "render": "blender --background --python pipeline/iso_render.py -- --out pipeline/out",
    "pack": "python3 pipeline/pack.py",
    "art:check": "python3 -m unittest discover -s pipeline -p 'test_*.py'",
    "art:camera": "blender --background --python-exit-code 1 --python pipeline/check_camera.py"
  },
  "dependencies": {
    "pixi.js": "^8.6.6",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/three": "^0.185.4",
    "playwright": "^1.62.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "wait-on": "^9.1.0"
  }
}
